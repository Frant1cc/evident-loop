# Copy to deploy/.env, chmod 600, and edit only on your deployment machine.
# Local preview defaults. On the server, replace localhost with its public IP.
SITE_HOST=localhost
APP_ORIGIN=http://localhost:8080
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=443
APP_VERSION=local

# Nginx has one fixed internal address; the backend trusts only that proxy.
# If this subnet conflicts with an existing Docker/VPN network, change both values.
DEMO_NETWORK_SUBNET=172.30.240.0/24
NGINX_INTERNAL_IP=172.30.240.10

LLM_PROVIDER=deepseek
LLM_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3
MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# Optional until you seed and index public sample knowledge.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_chunks
RAG_HYBRID=on

DEMO_VISITOR_DAILY_LIMIT=10
DEMO_IP_DAILY_LIMIT=10
DEMO_GLOBAL_DAILY_LIMIT=100
DEMO_GLOBAL_CONCURRENCY=3
DEMO_MAX_RUN_SECONDS=120
DEMO_MAX_MESSAGE_CHARS=2000
DEMO_MAX_LLM_CALLS=6
DEMO_MAX_OUTPUT_TOKENS=2048
DEMO_MAX_TOOL_CALLS=4
