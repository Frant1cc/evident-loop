{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "tsx --test src/streaming/*.test.ts src/markdown/*.test.ts src/tools/*.test.ts src/api/*.test.ts src/types/*.test.ts src/lib/*.test.ts",
    "typecheck": "vue-tsc -b --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@evident-loop/stream-protocol": "workspace:*",
    "@phosphor-icons/vue": "^2.2.1",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx-preview": "^0.4.0",
    "dompurify": "^3.4.12",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.6",
    "reka-ui": "^2.10.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.0"
  }
}
