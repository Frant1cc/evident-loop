{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "tsx --test src/streaming/*.test.ts src/markdown/*.test.ts",
    "typecheck": "vue-tsc -b --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@evident-loop/stream-protocol": "workspace:*",
    "@phosphor-icons/vue": "^2.2.1",
    "docx-preview": "^0.4.0",
    "dompurify": "^3.4.12",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.6",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.5.2",
    "postcss": "^8.5.18",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.0"
  }
}
