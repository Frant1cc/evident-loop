PORT=3000
# 文本模型 Provider：deepseek 或 minimax
LLM_PROVIDER=deepseek
# 可选：统一覆盖所选 Provider 的模型名
LLM_MODEL=
# 是否在流式对话中展示推理过程
LLM_REASONING=off

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# 单次模型请求尝试的超时；研究任务本身不设全局硬超时
DEEPSEEK_REQUEST_TIMEOUT_MS=60000

# MiniMax 中国区 OpenAI 兼容接口；国际账号可改为 https://api.minimax.io/v1
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_REQUEST_TIMEOUT_MS=90000
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_chunks
# 检索策略：on 启用 Hybrid（Dense+FTS5 加权 RRF+同文档限流，A/B 评测优于纯向量），留空为 dense
RAG_HYBRID=on
# P3 查询改写：只在弱检索且预算允许时调用当前 LLM Provider；最多生成 2 个改写，总查询数不超过 3
RAG_QUERY_REWRITE=on
# 留空时跟随当前 Provider 的默认模型
RAG_QUERY_REWRITE_MODEL=
# Word 文档产物配置：默认保存到 backend/data/artifacts，24 小时后过期
ARTIFACTS_DIR=
ARTIFACT_TTL_HOURS=24
