PORT=3000
# 管理接口默认只绑定回环地址；多设备部署时请显式设置并禁用 stdio MCP。
HOST=127.0.0.1
# 逗号分隔的浏览器 Origin allowlist；留空时允许本地 Vite 来源和请求 Host 同源。
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 32 字节随机密钥的 Base64（可用 node -e "console.log(require('crypto').randomBytes(32).toString('base64'))" 生成）
MCP_CREDENTIALS_KEY=
# 可选固定回调地址；默认 http://HOST:PORT/api/mcp/oauth/callback
MCP_OAUTH_REDIRECT_URI=
# 文本模型 Provider：deepseek 或 minimax
LLM_PROVIDER=deepseek
# 可选：统一覆盖所选 Provider 的模型名
LLM_MODEL=
# 可选：仅用于研究产物大纲/修复；留空时回退当前研究模型
ARTIFACT_MODEL=
# 是否在流式对话中展示推理过程
LLM_REASONING=off

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# 单次模型请求尝试的超时；研究任务本身不设全局硬超时
DEEPSEEK_REQUEST_TIMEOUT_MS=60000

# MiniMax 中国区 OpenAI 兼容接口；国际账号可改为 https://api.minimax.io/v1
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_REQUEST_TIMEOUT_MS=90000
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_chunks
# 检索策略：on 启用 Hybrid（Dense+FTS5 加权 RRF+同文档限流，A/B 评测优于纯向量），留空为 dense
RAG_HYBRID=on
# P3 查询改写：只在弱检索且预算允许时调用当前 LLM Provider；最多生成 2 个改写，总查询数不超过 3
RAG_QUERY_REWRITE=on
# 留空时跟随当前 Provider 的默认模型
RAG_QUERY_REWRITE_MODEL=

# 联网检索 Provider：按 capability 在同类 Provider 内动态回退。
# web_search: Zhipu/Tavily/Firecrawl; docs_search: Context7/Exa;
# web_fetch: native/Jina/Firecrawl。未配置的 Provider 会被安全跳过。
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_SEARCH_ENGINE=search_std
JINA_API_KEY=
JINA_READER_BASE_URL=https://r.jina.ai
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2
CONTEXT7_API_KEY=
CONTEXT7_BASE_URL=https://context7.com/api/v2
EXA_API_KEY=
EXA_BASE_URL=https://api.exa.ai
# Word 文档产物配置：默认保存到 backend/data/artifacts，24 小时后过期
ARTIFACTS_DIR=
ARTIFACT_TTL_HOURS=24
# 真实产物 QA 的短生命周期命令；缺失时 preflight/生成返回 renderer_unavailable
LIBREOFFICE_BIN=soffice
POPPLER_PDFINFO_BIN=pdfinfo
POPPLER_PDFTOPPM_BIN=pdftoppm
POPPLER_PDFTOTEXT_BIN=pdftotext
POPPLER_PDFFONTS_BIN=pdffonts
# 可选重排：默认关闭，未配置或失败时回退 RRF 结果
RAG_RERANK_ENABLED=false
RAG_RERANK_MODEL=
RAG_RERANK_TOP_N=8
# 知识库多格式导入
KNOWLEDGE_MAX_UPLOAD_BYTES=20000000
KNOWLEDGE_MAX_EXTRACTED_BYTES=5000000
KNOWLEDGE_MAX_PDF_PAGES=500
KNOWLEDGE_FILES_DIR=
