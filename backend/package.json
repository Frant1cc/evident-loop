{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/agent/*.test.ts src/rag/*.test.ts src/runtime/*.test.ts src/documents/*.test.ts src/artifacts/*.test.ts src/research/*.test.ts src/web/*.test.ts",
    "runtime:verify": "tsx src/runtime/verify.ts",
    "rag:sync": "tsx src/rag/syncCli.ts",
    "rag:eval:validate": "tsx src/rag/eval/validateFixtures.ts",
    "rag:eval": "tsx src/rag/eval/cli.ts",
    "rag:eval:smoke": "tsx src/rag/eval/smoke.ts"
  },
  "dependencies": {
    "@qdrant/js-client-rest": "^1.18.0",
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "docx": "^9.7.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
